# ==============================================================================
# RFC OFFICE - I-ANATRA LICENSE SERVER (FIREBASE)
# Modèle de variables d'environnement et secrets
# NE JAMAIS COMMITER DE VRAIS SECRETS DANS GIT / GITHUB !
# En production, utiliser Firebase Secret Manager :
#   firebase functions:secrets:set HMAC_SECRET
#   firebase functions:secrets:set ED25519_PRIVATE_KEY
# ==============================================================================

# Clé secrète pour le poivre cryptographique de hachage des clés (HMAC-SHA256)
HMAC_SECRET=generate_strong_random_secret_with_openssl_rand_hex_32

# Clé privée Ed25519 (Format Base64, 32 ou 64 octets) pour signature des certificats
# Générée via script de bootstrap ou OpenSSL
ED25519_PRIVATE_KEY=your_base64_encoded_ed25519_private_key_here

# Clé publique Ed25519 correspondante (Base64, 32 octets)
ED25519_PUBLIC_KEY=your_base64_encoded_ed25519_public_key_here

# Période de grâce hors ligne (en jours, défaut: 30)
GRACE_PERIOD_DAYS=30

# Environnement (development | production)
NODE_ENV=development

# Variables pour l'Émulateur Firebase local (décommenter pour tests locaux)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
