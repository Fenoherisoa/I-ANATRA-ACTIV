# I-ANATRA License Server - Configuration d'environnement
# © 2026 RFC OFFICE — Tous droits réservés

NODE_ENV=production
PORT=3000

# Base de données PostgreSQL de production
DATABASE_URL="postgresql://ianatra_user:MotDePasseFort2026@localhost:5432/ianatra_licensing?schema=public"

# Clé privée Ed25519 (64 octets en base64) - NE JAMAIS PARTAGER NI COMMITER
LICENSE_PRIVATE_KEY=""

# Clé publique Ed25519 (32 octets en base64) distribuée avec I-ANATRA client
LICENSE_PUBLIC_KEY=""

# Clé secrète JWT pour les sessions administrateur (min 64 caractères)
JWT_SECRET=""

# Sel applicatif (Pepper) pour le hachage des clés de licence
LICENSE_PEPPER="RFC-IANATRA-PEPPER-2026"

# URL publique de l'API
API_BASE_URL="https://license.rfc-office.com"
